# ---- Discord ----
# Bot Token aus dem Discord Developer Portal
DISCORD_TOKEN=dein_bot_token_hier

# Bot Owner (hat immer Zugriff auf /setup)
BOT_OWNER_ID=1313187996790427688

# Optional: Slash-Commands sofort nur in diesem Server syncen (schneller zum Testen)
# DEV_GUILD_ID=123456789012345678

# ---- Datenbank (Supabase Postgres) ----
# Supabase -> Project Settings -> Database -> Connection string -> URI
# Empfohlen: "Connection Pooling" (Port 6543) fuer Render
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:PASSWORT@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Alternativ akzeptiert der Bot auch DATABASE_URL
# DATABASE_URL=
